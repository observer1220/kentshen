{
  "name": "kentshen",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only page routes go through the Worker (workers.dev → kentshen.com redirect).
    // Hashed JS/CSS and thumbnails are served straight from the asset layer, which
    // is free and does not count as a Worker request. Every page is prerendered, so an
    // unlisted path that has no file is a real 404 (dist/404.html, status 404) instead
    // of the home page with status 200, which Google files as a duplicate. Add a pattern here when
    // you add a new top-level page route.
    "run_worker_first": ["/", "/index.html", "/blog", "/blog/*", "/contact", "/about", "/privacy"],
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "kentshen.com", "custom_domain": true }]
}
